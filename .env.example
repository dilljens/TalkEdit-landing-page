# TalkEdit Landing Page — Cloudflare Pages Required Environment Variables
#
# Copy this file to .env and fill in values for local dev/testing.
# These are set as encrypted environment variables in Cloudflare Pages dashboard:
#   Dashboard → talk-edit-landing-page → Settings → Environment Variables

# Stripe webhook signing secret (starts with whsec_)
# Get from: Stripe Dashboard → Developers → Webhooks → talk-edit endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Resend API key for email delivery of license keys
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Ed25519 private key (hex) for signing license keys
# Must match the public key in src-tauri/src/licensing.rs (TALKEDIT_PUBLIC_KEY)
# Generate: python3 -c "from nacl.signing import SigningKey; print(SigningKey.generate().encode().hex())"
LICENSE_PRIVATE_KEY=your_64_char_hex_private_key_here

# Sender email for license delivery and newsletter emails
LICENSE_SENDER_EMAIL=hello@talk-edit.com

# Optional: admin email for new subscriber notifications
ADMIN_EMAIL=dillon@talk-edit.com
